#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# =============================================================================
#  MaSalle -- le projet de l'etudiant, lie au KIT R3D (NKRHI, NKRenderer, NKAudio...).
#
#  Le kit est dans Kits/R3D : ses en-tetes, ses bibliotheques deja
#  construites (Debug et Release), les nuanceurs de NKRenderer. Aucun clone du
#  moteur, aucun SDK a installer.
# =============================================================================
from Jenga import *

with workspace("MaSalleWks", location="."):
    configurations(["Debug", "Release"])

    # Le kit : il definit user3d(), que chaque projet appelle.
    useconfig("Kits/R3D/R3D.jenga")

    with project("MaSalle"):
        consoleapp()
        language("C++")
        cppdialect("C++17")
        location(".")
        files(["src/**.cpp"])

        user3d()        # en-tetes, dossiers de bibliotheques, archives, bibliotheques du systeme

        # Release : sans cette ligne, le compilateur ne recoit AUCUNE option d'optimisation et Release n'est pas
        # plus rapide que Debug (exercice 7). "Speed" donne -O2 (Builder.py de Jenga) ; NDEBUG marque la
        # configuration Release pour cout.cpp.
        with filter("config:Release"):
            optimize("Speed")
            defines(["NDEBUG"])

        # Un executable qui tourne SEUL : la bibliotheque C++ du compilateur (libc++,
        # libunwind) est liee dedans. Sans cela, le programme reclame libc++.dll et
        # libunwind.dll au lancement, et ne demarre que sur la machine du compilateur.
        with filter("system:Windows"):
            ldflags(["-static"])

        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
        targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

        # NKRenderer lit ses nuanceurs dans Resources/NKRenderer/Shaders, RELATIF AU
        # DOSSIER COURANT. On les copie depuis le kit : dans ce dossier (NKCode lance
        # le programme d'ici) et a cote de l'executable. Une commande du systeme, sans
        # Python : sous NKCode, le Python de Jenga est NKCode lui-meme, et le relancer
        # rouvrait NKCode au lieu de copier (31 octobre 2026). Pas de robocopy : il
        # rend 1 quand la copie reussit, et la construction echouerait. Le dossier
        # copie est vide d'abord : un nuanceur d'un ancien kit, reste la, pouvait se faire
        # charger a la place du nouveau (« softness is not a member of ShadowUBO »).
        _SRC = "%{wks.location}/Kits/R3D/Resources/NKRenderer/Shaders"
        _DST = ["%{wks.location}/Resources/NKRenderer/Shaders",
                "%{prj.targetdir}/Resources/NKRenderer/Shaders"]
        with filter("system:Windows"):
            postbuild([c for d in _DST for c in ('if exist "%s" rmdir /S /Q "%s"' % (d, d),
                                                 'xcopy /E /I /Y /Q "%s" "%s"' % (_SRC, d))])
        with filter("system:Linux"):
            postbuild(['rm -rf "%s" && mkdir -p "%s" && cp -R "%s/." "%s"' % (d, d, _SRC, d) for d in _DST])
        with filter("system:macOS"):
            postbuild(['rm -rf "%s" && mkdir -p "%s" && cp -R "%s/." "%s"' % (d, d, _SRC, d) for d in _DST])
