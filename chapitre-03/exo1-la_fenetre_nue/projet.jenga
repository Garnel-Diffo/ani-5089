#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
from Jenga import *
from Jenga.GlobalToolchains import RegisterJengaGlobalToolchains

NKWINDOW_SRC = os.getenv(
    "NKENTSEU_NKWINDOW_SRC",
    r"C:\Jenga\Jenga\Exemples\27_nk_window\NKWindow"
)
NKWINDOW_EXTERNALS = os.getenv(
    "NKENTSEU_EXTERNALS",
    r"C:\Jenga\Jenga\Exemples\27_nk_window\Externals"
)

with workspace("SalleWks", location="."):
    RegisterJengaGlobalToolchains()
    configurations(["Debug", "Release"])

    with project("Salle"):
        windowedapp()
        language("C++")
        cppdialect("C++17")
        location(".")
        usetoolchain("msvc")

        includedirs([
            NKWINDOW_SRC + "/src",
            NKWINDOW_EXTERNALS,
            "compat",
            NKWINDOW_SRC + "/src/NKWindow/Core",
        ])

        files([
            "main.cpp",
            NKWINDOW_SRC + "/src/NKWindow/Core/NkDialogs.cpp",
            NKWINDOW_SRC + "/src/NKWindow/Core/NkEvent.cpp",
            NKWINDOW_SRC + "/src/NKWindow/Core/NkGamepadSystem.cpp",
            NKWINDOW_SRC + "/src/NKWindow/Core/NkRenderer.cpp",
            NKWINDOW_SRC + "/src/NKWindow/Core/NkWindow.cpp",
            NKWINDOW_SRC + "/src/NKWindow/Core/Camera/NkCameraSystem.cpp",
            NKWINDOW_SRC + "/src/NKWindow/Core/Events/NkEventTypes.cpp",
            NKWINDOW_SRC + "/src/NKWindow/Renderer/Software/NkSoftwareRendererImpl.cpp",
            "compat/core_fixed/NkEventSystem.cpp",
            "compat/core_fixed/NkSystem.cpp",
            "compat/platform_win32/NkWin32EventImpl.cpp",
            "compat/platform_win32/NkWin32WindowImpl.cpp",
        ])

        defines([
            "NKENTSEU_PLATFORM_WIN32=1",
            "WIN32_LEAN_AND_MEAN",
            "NOMINMAX",
            "_UNICODE",
            "UNICODE",
        ])

        cxxflags(["/FS", "/EHsc"])

        links([
            "user32", "gdi32", "opengl32", "dwmapi", "shell32",
            "xinput", "mf", "mfplat", "mfreadwrite", "mfuuid",
            "uuid", "ole32",
        ])
